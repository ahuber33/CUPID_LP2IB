# ------------------------- VISUALIZATION -------------------------
#/vis/open OGL 600x600-0+0                                         # Open an OpenGL viewer with a 600x600 pixel window
/vis/drawVolume                                                   # Draw the full geometry
#/vis/viewer/set/style wireframe                                  # (optional) Set geometry to wireframe style
/vis/viewer/set/viewpointThetaPhi 0 0                             # Set the camera viewpoint angles theta=0, phi=0
/vis/viewer/set/upVector 0 0 1                                    # Set the camera "up" vector
/vis/viewer/set/viewpointVector -0.99 0 0.01                      # Set the camera pointing vector
/vis/viewer/zoom 1.                                               # Set initial zoom to 1x


###################################################################
################# PART FOR MESSENGER INFORMATION ##################
###################################################################


#/SCOPSim/geometry/setLMOSurfaceModel glisur
#/SCOPSim/geometry/setLMOSurfaceType dielectric_dielectric
#/SCOPSim/geometry/setLMOSurfaceFinish ground
#/SCOPSim/geometry/setLMOSurfacePolish 1.0
#/SCOPSim/geometry/setLMOSurfaceSigmaAlpha 0.1

#/SCOPSim/geometry/setDetectorDistance 100 mm             # Set Detector Distance

/run/reinitializeGeometry                                           # Apply geometry changes
/run/physicsModified                                                # Notify Geant4 physics has changed
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year

# ------------------------- PHOTON TRACKING (Batch, no VIS) ------------------
/tracking/storeTrajectory 1                                         # Force storage of all trajectories
/SCOPSim/step/setVerbose 0 
/SCOPSim/step/setPhotonTrackStatus true                               # Track optical photons

/tracking/verbose 0                                                 # Step-by-step tracking output
/run/verbose 1                                                      # Run output

###################################################################
########## PART TO SIMULATE PARTICLE WITH GPS (no setgun) #########
###################################################################
/gps/number 1                                                     # Generate 1 particle

# ---------------- Generate particle in crystal ---------------------------
/gps/particle e-                            # Set particle type
/gps/energy 1 MeV                           # Particle energy

/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/halfx 22.5 mm
/gps/pos/halfy 22.5 mm
/gps/pos/halfz 22.5 mm
/gps/pos/centre 0.0 0.0 0.0 mm              # Particle start position
/gps/ang/type iso                           # Particle isotropic direction
# -------------------------------------------------------------------------

# ---------------- Generate decaying source outside -----------------------
#/gps/particle ion
#/gps/energy 0. MeV                           # Particle energy
#/gps/ion 92 238 0 0
#/gps/pos/centre -25 0.0 0.0 mm               # Particle start position
#/gps/direction 1.0 0.0 0.0                    # Particle direction along Y-axis
#/gps/ang/maxtheta 180 deg


#/gps/ene/type Lin
#/gps/ene/gradient 0
#/gps/ene/intercept 1
#/gps/ene/min 1000 keV
#/gps/ene/max 6000 keV
